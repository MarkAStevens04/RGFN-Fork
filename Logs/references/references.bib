@article{fromer2024sparrow,
  title   = {An algorithmic framework for synthetic cost-aware decision making in molecular design},
  author  = {Fromer, Jenna C. and Coley, Connor W.},
  journal = {Nature Computational Science},
  year    = {2024},
  volume  = {4},
  pages   = {440--450},
  doi     = {10.1038/s43588-024-00639-y},
  eprint  = {2311.02187},
  archivePrefix = {arXiv},
  url     = {https://www.nature.com/articles/s43588-024-00639-y},
  note    = {SPARROW ("Synthesis Planning And Rewards-based Route Optimization Workflow",
             coleygroup/sparrow): a mixed-integer linear program over a MERGED retrosynthetic graph
             that jointly chooses WHICH candidate molecules to make and WHICH routes to make them by,
             scalarizing three terms with weights lambda = [l1, l2, l3] -- cumulative reward of the
             selected candidates (maximized), starting-material cost, and a per-reaction penalty
             inversely proportional to success probability (both minimized). Because compounds are
             deduplicated by canonical SMILES, shared intermediates collapse to one node and are
             amortized automatically. We use it in TWO distinct roles and conflating them misreads
             every result (docs/RESEARCH_CONTEXT.md, "How library cost is measured"):
             (1) SPARROW-VERIFIER (SV) -- independent auditor of a library we already chose
             (constrain_all_targets=True, reward weight 0); the source of "count-once is within
             0.0-3.1% of provably optimal" (Logs/042 gate, Logs/049). (2) SPARROW-BATCHING (SB) --
             a genuine COMPETITOR that picks the batch itself under a hard --max-rxns budget
             (constrain_all_targets=False, reward-bearing objective); the competitor's selector in
             the headline (Logs/056) and in the BC-SB / BC-Enum-SB arms (Logs/059). Objective sign
             convention verified against LinearSelector.set_objective: it MINIMIZES
             -w0*sum(reward*selected) + w1*sum(SM cost) + w2*sum(reaction penalty), so
             weights=[1,0,0,0,0] plus a hard max_rxns maximizes selected reward under a reaction
             budget (a hard budget was chosen over a reaction penalty deliberately -- a penalty
             requires inventing an exchange rate between reward units and reactions). CRITICAL for
             our argument: the objective has NO diversity term, and the paper says so itself --
             "SPARROW currently does not consider marginal information gain related to molecular
             diversity and matched molecular pairs" -- which is why the distinctness of an SB
             selection is always MEASURED, never assumed, and why SB concentrates its picks on a
             handful of intermediates (Logs/059: 78% from one at the tightest budget). Practical
             limit: the MILP is superlinear in pool size (~1 s per budget point at 500 targets,
             >110 s at 2,000), so a pool that fails to solve is itself a reportable datapoint.
             Own `sparrow` conda env (external/setup_sparrow.sh) + PuLP/CBC; crossed by subprocess
             via validation/lsdflow/adapters/workers/sparrow_worker.py.
             PDF: pdfs/fromer2024sparrow.pdf.}
}

@article{ianez2026multiaiz,
  title   = {Joint synthesis planning by leveraging common intermediates},
  author  = {I{\'a}{\~n}ez Picazo, Pablo and Voronov, Alexey and Genheden, Samuel and Westerlund, Annie M.},
  journal = {Artificial Intelligence in the Life Sciences},
  year    = {2026},
  doi     = {10.1016/j.ailsci.2026.100175},
  url     = {https://www.sciencedirect.com/science/article/pii/S2667318526000231},
  note    = {MultiAiZ (MolecularAI/multiaiz): extends AiZynthFinder to MULTI-TARGET retrosynthesis by
             iteratively appending discovered intermediates to the stock (the paper uses 5 cycles) so
             targets converge on shared intermediates, then ranks them by the novel "intermediate
             score". The SECOND competitor route-planner for the LSD-Flow library-efficiency benchmark
             (docs/LSD_FLOW_BENCHMARK_PLAN.md T4.1): each acquisition function's accepted-mode pool is
             priced in ISOLATION by MultiAiZ->SPARROW (shared intermediates found within a pool are NOT
             shared to other pools) to test whether smarter shared-intermediate discovery lowers
             reactions-per-mode vs plain AiZynth->SPARROW. Molecular AI / AstraZeneca (same group as
             AiZynthFinder). PDF: pdfs/ianez2026multiaiz.pdf.}
}

% --- Information-theoretic active learning: the BALD / BatchGFN family ---

@inproceedings{malik2023batchgfn,
  title     = {{BatchGFN}: Generative Flow Networks for Batch Active Learning},
  author    = {Malik, Shreshth A. and Lahlou, Salem and Jesson, Andrew and Jain, Moksh and Malkin, Nikolay and Deleu, Tristan and Bengio, Yoshua and Gal, Yarin},
  booktitle = {ICML Workshop on Structured Probabilistic Inference \& Generative Modeling (SPIGM)},
  year      = {2023},
  eprint    = {2306.15058},
  archivePrefix = {arXiv},
  url       = {https://github.com/s-a-malik/batchgfn},
  note      = {Pool-based batch active learning with a GFlowNet whose STATE is the query batch under
               construction and whose ACTIONS add pool points; reward = exp(JMI/T) where JMI is
               BatchBALD's joint mutual information I[y_1:B, theta | x_1:B, D_train], computed in
               CLOSED FORM under an exact GP. Sampling is O(B) (B forward passes) versus BatchBALD's
               joint entropies over the whole pool. Evaluated ONLY on a toy 1D regression task (pool
               2000, seed 10, query 10); baselines random / BALD / stochastic-BALD / BatchBALD.
               KEY RESULT FOR US (their Sec. 4.2-4.3): BatchGFN is "on par with BatchBALD" and beats
               BALD + random -- i.e. its contribution is AMORTIZING the greedy objective, not
               improving it, so greedy BatchBALD UPPER-BOUNDS it. That is why docs/
               LSD_FLOW_BENCHMARK_PLAN.md Sec. 11 implements greedy BatchBALD rather than a
               subset-GFlowNet. Their own speed-up is modest in-setting (~10% for a single sample).
               No cost model: every pool point costs the same to label -- the axis LSD-Flow owns.
               ICML 2023 workshop paper (10pp), explicitly "early results".
               PDF: pdfs/malik2023batchgfn.pdf.}
}

@misc{zhang2025baldgfn,
  title         = {Why Pool When You Can Flow? Active Learning with {GFlowNets}},
  author        = {Zhang, Renfei and Pandey, Mohit and Cherkasov, Artem and Ester, Martin},
  year          = {2025},
  eprint        = {2509.00704},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  note          = {BALD-GFlowNet: the GENERATIVE successor to pool-based information acquisition, and
                   the stronger of the two benchmark targets for docs/LSD_FLOW_BENCHMARK_PLAN.md
                   Sec. 11. Replaces "which pool point is most informative?" with "what does an
                   informative sample LOOK like?" -- a GFlowNet is trained to sample proportional to
                   the BALD reward, so acquisition cost is INDEPENDENT of pool size. NOTE it uses
                   SINGLE-POINT BALD, I(y; omega | x, D) over an ensemble -- NOT BatchBALD's joint MI
                   -- so it inherits BALD's batch-redundancy weakness and leans on GFlowNet diversity
                   + a composite reward to offset it. That composite reward is MULTIPLICATIVE:
                   Reward(x) = MI(x) * TPSA(x) * QED(x) * SAS(x) * Rings(x) -- our precedent for
                   giving the information baseline a quality term so we are not beating a strawman
                   (Sec. 11.2 decision 7). Surrogate = an ensemble binary classifier on an imbalanced
                   docking-score task. Experiments: a 2D grid + JAK2 virtual screening (Enamine REAL),
                   finetuning a pretrained ATOM-LEVEL graph-Transformer GFlowNet. Results: comparable
                   F1 to the BALD baseline (>90% of BALD's max F1 at the oracle cost of one BALD
                   iteration), 12.5% runtime reduction at a 12M library, more structurally diverse
                   molecules. Its generator is atom-level with no reaction grounding and no synthesis
                   cost, so it has the same library-economics blind spot as [kim2026s3gfn].
                   SFU / UBC Vancouver Prostate Centre / Diagen AI. PDF: pdfs/zhang2025baldgfn.pdf.}
}
